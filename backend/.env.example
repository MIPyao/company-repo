# 服务器配置
PORT=3000
HOST=0.0.0.0

# 数据库配置
DATABASE_URL="postgresql://user:password@localhost:5432/inquiry_db?schema=public"

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Redis 配置（可选）
REDIS_URL=redis://localhost:6379

# Paperclip 集成
PAPERCLIP_API_URL=https://api.paperclip.io
PAPERCLIP_API_KEY=your-paperclip-api-key
PAPERCLIP_COMPANY_ID=your-company-id

# 邮件配置（可选）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@mipyao.com
