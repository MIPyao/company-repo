// Prisma schema for MIPYAO Inquiry System
// Based on database-design document from MIP-2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 客户表
model Customer {
  id            String   @id @default(uuid())
  companyName   String   @map("company_name")
  contactName   String   @map("contact_name")
  phone         String?
  email         String   @unique
  address       String?
  industry      String?
  customerLevel String   @default("regular") @map("customer_level")
  status        String   @default("active")
  inquiries     Inquiry[]
  quotations    Quotation[]
  orders        Order[]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([companyName])
  @@index([status])
  @@map("customers")
}

// 产品分类表
model ProductCategory {
  id        String   @id @default(uuid())
  name      String
  parentId  String?  @map("parent_id")
  level     Int      @default(1)
  sortOrder Int      @default(0) @map("sort_order")
  products  Product[]
  children  ProductCategory[] @relation("CategoryHierarchy", fields: [parentId], references: [id])
  parent    ProductCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_categories")
}

// 产品表
model Product {
  id           String   @id @default(uuid())
  name         String
  model        String?
  description  String?
  categoryId   String?  @map("category_id")
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  costPrice    Decimal? @map("cost_price") @db.Decimal(10, 2)
  stockStatus  String   @default("in_stock") @map("stock_status")
  isActive     Boolean  @default(true) @map("is_active")
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  inquiryItems InquiryItem[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([name])
  @@index([model])
  @@index([isActive])
  @@map("products")
}

// 询价单表
model Inquiry {
  id              String   @id @default(uuid())
  inquiryNo       String   @unique @map("inquiry_no")
  customerId      String   @map("customer_id")
  status          String   @default("pending")
  expectedDate    DateTime? @map("expected_date")
  priority        String   @default("normal")
  assignedTo      String?  @map("assigned_to")
  totalAmount     Decimal? @map("total_amount") @db.Decimal(12, 2)
  remark          String?
  paperclipIssueId String?  @map("paperclip_issue_id")
  customer        Customer @relation(fields: [customerId], references: [id])
  items           InquiryItem[]
  quotation      Quotation?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("inquiries")
}

// 询价单明细表
model InquiryItem {
  id         String   @id @default(uuid())
  inquiryId  String   @map("inquiry_id")
  productId  String   @map("product_id")
  quantity   Int      @default(1)
  unitPrice  Decimal? @map("unit_price") @db.Decimal(10, 2)
  subtotal   Decimal? @db.Decimal(12, 2)
  remark     String?
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@index([inquiryId])
  @@index([productId])
  @@map("inquiry_items")
}

// 报价单表
model Quotation {
  id              String   @id @default(uuid())
  quotationNo     String   @unique @map("quotation_no")
  inquiryId      String   @unique @map("inquiry_id")
  customerId      String   @map("customer_id")
  status          String   @default("draft")
  totalAmount     Decimal  @map("total_amount") @db.Decimal(12, 2)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  finalAmount     Decimal  @map("final_amount") @db.Decimal(12, 2)
  validUntil      DateTime? @map("valid_until")
  pdfUrl          String?  @map("pdf_url")
  paperclipIssueId String?  @map("paperclip_issue_id")
  inquiry         Inquiry  @relation(fields: [inquiryId], references: [id])
  customer        Customer @relation(fields: [customerId], references: [id])
  order           Order?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("quotations")
}

// 订单表
model Order {
  id              String   @id @default(uuid())
  orderNo         String   @unique @map("order_no")
  quotationId    String?  @unique @map("quotation_id")
  customerId      String   @map("customer_id")
  status          String   @default("pending")
  totalAmount     Decimal  @map("total_amount") @db.Decimal(12, 2)
  deliveryDate    DateTime? @map("delivery_date")
  paperclipIssueId String?  @map("paperclip_issue_id")
  quotation       Quotation? @relation(fields: [quotationId], references: [id])
  customer        Customer  @relation(fields: [customerId], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("orders")
}
