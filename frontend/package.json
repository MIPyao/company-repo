{
  "name": "@mipyao/inquiry-system-frontend",
  "version": "0.1.0",
  "description": "MIPYAO 产品询价系统前端 - Vue 3 + Vite + Element Plus",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .vue,.js,.ts,.jsx,.tsx",
    "lint:fix": "eslint src/ --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "format": "prettier --write \"src/**/*.{vue,js,ts,json,md}\"",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": ["mipyao", "inquiry", "vue3", "vite"],
  "author": "MIPYAO CTO <cto@mipyao.com>",
  "license": "MIT",
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.0",
    "element-plus": "^2.7.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.0",
    "@element-plus/icons-vue": "^2.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "vite": "^5.3.0",
    "vue-tsc": "^2.0.0",
    "typescript": "^5.5.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prettier": "^3.2.0",
    "vitest": "^1.6.0",
    "sass": "^1.77.0"
  }
}