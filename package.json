{
  "name": "@mipyao/company-repo",
  "version": "1.0.0",
  "description": "MIPYAO 公司代码仓库 - 核心项目、工具库和基础设施代码",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "lint": "eslint src/ tests/ --ext .js,.ts",
    "lint:fix": "eslint src/ tests/ --ext .js,.ts --fix",
    "format": "prettier --write \"src/**/*.{js,ts,json,md}\" \"tests/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,json,md}\" \"tests/**/*.{js,ts}\"",
    "test": "node scripts/test.js",
    "test:coverage": "npm test -- --coverage"
  },
  "keywords": ["mipyao", "company", "infrastructure"],
  "author": "MIPYAO CTO <cto@mipyao.com>",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
